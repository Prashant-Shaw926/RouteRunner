{
  "expo": {
    "name": "RouteRunner",
    "slug": "routerunner",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "routerunner",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.prashantshaw.routerunner"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
